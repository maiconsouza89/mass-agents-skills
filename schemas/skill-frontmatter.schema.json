{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maiconsouza89.github.io/mass-agents-skills/schemas/skill-frontmatter.schema.json",
  "title": "Mass Solutions SKILL.md frontmatter",
  "description": "Frontmatter contract for every skill in the catalog. Top-level keys are limited to the Agent Skills open standard; company fields live under metadata.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "description", "metadata"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 64,
      "description": "Kebab-case identifier. Must equal the folder name. Must not contain 'claude' or 'anthropic'."
    },
    "description": {
      "type": "string",
      "minLength": 80,
      "maxLength": 1024,
      "description": "Single line following the formula: [What it does]. Use when [quoted trigger phrases]. Do NOT use for [negatives]."
    },
    "license": { "type": "string" },
    "compatibility": { "type": "string", "maxLength": 500 },
    "allowed-tools": { "type": "string" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "version", "reviewed", "category", "tags"],
      "properties": {
        "owner": { "type": "string", "pattern": "^(@[A-Za-z0-9_-]+|team:[a-z0-9-]+)$" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "reviewed": { "type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "category": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "tags": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
        },
        "requires": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "skills": { "type": "array", "items": { "type": "string" } },
            "tools": { "type": "array", "items": { "type": "string" } },
            "mcp": { "type": "array", "items": { "type": "string" } }
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "ref", "license"],
          "properties": {
            "url": { "type": "string", "pattern": "^https://" },
            "ref": { "type": "string", "minLength": 1 },
            "license": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
